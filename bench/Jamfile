# The throughput of PBKDF2-HMAC-SHA-512 at 1,000,000 iterations (spec 4.3),
# and the cost of the timing guard (timing.cpp).
# pbkdf2_sha512_key is the correctness test of the measured program: each
# variant's derived key against an independent value, on every target, never
# failing on a time. The measurements themselves are made by collect.py, which
# runs the program built here, doc/performance.adoc renders its data.

project : requirements <library>/webcpp/hash//hash ;

import webcpp ;
import webcpp-target ;

webcpp.targets native wasip2 wasip3 emscripten ;

# OpenSSL on the targets that have it; Emscripten has none (spec section 5.6).
rule with-openssl ( properties * )
{
    if [ webcpp-target.target-of $(properties) ] in native wasip2 wasip3
    {
        return <library>/webcpp/hash//openssl ;
    }
}

# Optimised, as a measurement is: collect.py builds it with variant=release
# optimization=speed too.
.requirements = <library>/third_party//sodium <conditional>@with-openssl
    <optimization>speed ;
webcpp.run pbkdf2_sha512_key : pbkdf2_sha512.cpp : $(.requirements) ;

# The same program at variant=release, the one collect.py measures, run by
# hand (doc/performance.adoc); no lane measures it. pbkdf2_sha512_key runs in
# every lane of test/ (test/Jamfile builds this project).
exe pbkdf2_sha512 : pbkdf2_sha512.cpp : $(.requirements) <variant>release ;
explicit pbkdf2_sha512 ;

# The cost of webcpp::secure::timing_guard, the scope every keyed function runs
# in (doc/performance.adoc). timing_check is the correctness test of the
# measured program, run in every lane of test/: the measurement at 10^3
# iterations, its line's form and the thread's DIT checked. The guard's cost
# needs no backend: <webcpp/secure/timing_guard.hpp> alone.
webcpp.run timing_check : timing.cpp : <optimization>speed ;

# The same program at variant=release, the one collect.py --timing measures,
# natively and by hand (doc/performance.adoc); no lane measures it.
exe timing : timing.cpp : <variant>release <optimization>speed ;
explicit timing ;

# The allocation counts of doc/allocation.adoc (spec section 7.7), from release
# builds only: the programs of test/allocation_test.cpp,
# test/allocation_openssl_test.cpp and test/allocation_botan_test.cpp built at
# variant=release, which
# allocation_collect.py collects from b2's
# bench/<name>.test/<toolset>/release/... and refuses anywhere else. The tests
# of test/ keep the lane's variant; no lane builds these.
.counting = <variant>release
    <target-os>wasi:<linkflags>-Wl,--wrap=malloc,--wrap=calloc,--wrap=realloc
    <target-os>wasi:<linkflags>-Wl,--wrap=aligned_alloc,--wrap=posix_memalign ;
webcpp.run allocation_release : ../test/allocation_test.cpp
  : <library>/webcpp/asio//asio
    <library>/third_party//xkcp <library>/third_party//blake3
    <library>/third_party//sodium <library>/third_party//bearssl $(.counting) ;
webcpp.run allocation_openssl_release : ../test/allocation_openssl_test.cpp
  : <library>/webcpp/hash//openssl $(.counting) : native wasip2 wasip3 ;
# Botan, with exceptions, on the targets it is built for (design D45).
webcpp.run allocation_botan_release : ../test/allocation_botan_test.cpp
  : <library>/third_party//botan <exception-handling>on $(.counting)
  : native emscripten ;
explicit allocation_release allocation_openssl_release allocation_botan_release ;
