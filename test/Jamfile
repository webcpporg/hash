project : requirements <library>/webcpp/hash//hash ;

import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

# Every test runs with exceptions on and off: the second program has the suffix
# _no_exceptions and is built with exception-handling=off, which links
# tools/throw_exception.cpp.
rule hash-run ( name : sources + : requirements * : targets * )
{
    webcpp.run $(name) : $(sources) : $(requirements) : $(targets) ;
    webcpp.run $(name)_no_exceptions : $(sources)
      : $(requirements) <exception-handling>off : $(targets) ;
}

webcpp.headers-alone hash : ../include :
    hash.hpp
    hash/algorithms.hpp
    hash/backends/hash2.hpp
    hash/config.hpp
    hash/detail/engines.hpp
    hash/detail/limits.hpp
    hash/detail/ranking.hpp
    hash/detail/wipe.hpp
    hash/detail/xkcp.hpp
    hash/error.hpp
    hash/hkdf.hpp
    hash/hmac.hpp
    hash/kdf.hpp
    hash/pbkdf2.hpp ;
# keccak.hpp compiles alone only with XKCP, whose target defines
# WEBCPP_HASH_HAS_XKCP (without it, it stops with its message).
webcpp.headers-alone hash : ../include : hash/keccak.hpp : <library>/third_party//xkcp ;
# blake3.hpp compiles alone only with BLAKE3's library, which defines
# WEBCPP_HASH_HAS_BLAKE3 (without it, it stops with its message).
webcpp.headers-alone hash : ../include : hash/blake3.hpp
  : <library>/third_party//blake3 ;
# backends/bearssl.hpp compiles alone only with BearSSL, whose target defines
# WEBCPP_HASH_HAS_BEARSSL (without it, it stops with its message).
webcpp.headers-alone hash : ../include : hash/backends/bearssl.hpp
  : <library>/third_party//bearssl ;

# backends/sodium.hpp compiles alone only with libsodium, which defines
# WEBCPP_HASH_HAS_SODIUM (without it, it stops with its message).
webcpp.headers-alone hash : ../include : hash/backends/sodium.hpp
  : <library>/third_party//sodium ;

# backends/openssl.hpp compiles alone only with /webcpp/hash//openssl, which
# defines WEBCPP_HASH_HAS_OPENSSL, on the targets where webcpp builds OpenSSL.
webcpp.headers-alone hash : ../include : hash/backends/openssl.hpp
  : <library>/webcpp/hash//openssl : native wasip2 wasip3 ;

# config.hpp defines WEBCPP_HASH_NO_EXCEPTIONS exactly when webcpp has no
# exceptions, keeps it when a developer defines it, defines it when
# WEBCPP_NO_EXCEPTIONS is, and classifies the target.
webcpp.compile config : config_test.cpp ;
webcpp.compile config_no_exceptions : config_test.cpp : <exception-handling>off ;
webcpp.compile config_all_off : config_test.cpp
  : <define>WEBCPP_NO_EXCEPTIONS <define>WEBCPP_TEST_HASH_ALL_OFF ;
webcpp.compile config_developer_defined : config_test.cpp
  : <define>WEBCPP_HASH_NO_EXCEPTIONS <define>WEBCPP_TEST_HASH_DEVELOPER_DEFINED ;

hash-run error : error_test.cpp ;

# Boost.Hash2's algorithms and HMAC are webcpp::hash's names for them.
hash-run algorithms : algorithms_test.cpp ;

# keccak_256 against Boost.Hash2's own Keccak-256 (spec section 1.3).
hash-run keccak : keccak_test.cpp : <library>/third_party//xkcp ;
# hash.hpp's branch for XKCP.
webcpp.compile hash_keccak : hash_keccak_test.cpp : <library>/third_party//xkcp ;
# keccak_256's read of the canary survives optimisation: with the library it
# links and runs; with another commit's canary it does not link.
hash-run keccak_canary : keccak_canary_test.cpp
  : <library>/third_party//xkcp <optimization>speed ;
webcpp.link-fail keccak_canary_other_commit : keccak_canary_test.cpp
  : <library>/third_party//xkcp <optimization>speed
    <define>WEBCPP_HASH_XKCP_CANARY_COMMIT=0000000 ;

# blake3 over BLAKE3's C implementation, on every target: Hash2's contract and
# the seeds against BLAKE3's C functions, and BLAKE3's official vectors.
hash-run blake3 : blake3_test.cpp : <library>/third_party//blake3 ;
hash-run blake3_vectors : blake3_vectors_test.cpp
  : <library>/third_party//blake3 <library>/third_party//blake3_vectors
    <library>/webcpp//boost_json ;

# HKDF (RFC 5869) on backends::hash2: the RFC's seven cases and three more
# computed by Python's hmac; the guards at their limits; the wipes, each one
# reported through the seam WEBCPP_HASH_DETAIL_TEST_WIPE_RECORD.
hash-run hkdf_hash2 : hkdf_hash2_test.cpp ;
hash-run hkdf_guards : hkdf_guards_test.cpp ;
hash-run wipe : wipe_test.cpp : <define>WEBCPP_HASH_DETAIL_TEST_WIPE_RECORD ;

# HKDF on backends::sodium, over libsodium's crypto_kdf_hkdf_sha256 and
# crypto_kdf_hkdf_sha512: RFC 5869's A.1 to A.3, a SHA-512 case that
# backends::hash2 agrees with, the guards of spec 2.8, the empty inputs, and
# the canary.
hash-run hkdf_sodium : hkdf_sodium_test.cpp : <library>/third_party//sodium ;
# The same test optimised: extract's result is built in place at -O2 too.
hash-run hkdf_sodium_speed : hkdf_sodium_test.cpp
  : <library>/third_party//sodium <optimization>speed ;
# The engines' read of the canary survives optimisation: with the library it
# links and runs; with another commit's canary it does not link.
hash-run hkdf_sodium_canary : hkdf_sodium_canary_test.cpp
  : <library>/third_party//sodium <optimization>speed ;
webcpp.link-fail hkdf_sodium_canary_other_commit : hkdf_sodium_canary_test.cpp
  : <library>/third_party//sodium <optimization>speed
    <define>WEBCPP_HASH_SODIUM_CANARY_COMMIT=0000000 ;

# PBKDF2 (RFC 8018) on backends::hash2: RFC 6070's cases and RFC 7914's two;
# RFC 6070's case 4 (16,777,216 iterations) alone; the guards at their limits.
hash-run pbkdf2_hash2 : pbkdf2_hash2_test.cpp ;
hash-run pbkdf2_rfc6070_long : pbkdf2_rfc6070_long_test.cpp ;
hash-run pbkdf2_guards : pbkdf2_guards_test.cpp ;

# HKDF on backends::bearssl: RFC 5869's seven cases through hkdf, the four
# other hmacs against backends::hash2, the guards, and the wipe of BearSSL's
# context, reported through the seam WEBCPP_HASH_DETAIL_TEST_WIPE_RECORD.
hash-run hkdf_bearssl : hkdf_bearssl_test.cpp
  : <library>/third_party//bearssl <define>WEBCPP_HASH_DETAIL_TEST_WIPE_RECORD ;
# Its read of webcpp::hash's canary survives optimisation: with the library it
# links and runs; with another commit's canary it does not link.
hash-run hkdf_bearssl_canary : hkdf_bearssl_canary_test.cpp
  : <library>/third_party//bearssl <optimization>speed ;
webcpp.link-fail hkdf_bearssl_canary_other_commit : hkdf_bearssl_canary_test.cpp
  : <library>/third_party//bearssl <optimization>speed
    <define>WEBCPP_HASH_BEARSSL_CANARY_COMMIT=0000000 ;

# HKDF and PBKDF2 on backends::openssl (OpenSSL 3.5.9's EVP_KDF), on the
# targets where webcpp builds OpenSSL: the RFCs' cases and backends::hash2's
# agreement over every hmac of spec 3.2's OpenSSL column; the thread's error
# queue left as found; a failure provoked through the seam
# WEBCPP_HASH_DETAIL_TEST_OPENSSL_DIGEST, a digest OpenSSL cannot fetch.
hash-run hkdf_openssl : hkdf_openssl_test.cpp : <library>/webcpp/hash//openssl
  : native wasip2 wasip3 ;
hash-run pbkdf2_openssl : pbkdf2_openssl_test.cpp
  : <library>/webcpp/hash//openssl : native wasip2 wasip3 ;
hash-run openssl_error_queue : openssl_error_queue_test.cpp
  : <library>/webcpp/hash//openssl : native wasip2 wasip3 ;
hash-run openssl_failure : openssl_failure_test.cpp
  : <library>/webcpp/hash//openssl
    <define>"\"WEBCPP_HASH_DETAIL_TEST_OPENSSL_DIGEST=\\\"NO-SUCH-DIGEST\\\"\""
  : native wasip2 wasip3 ;
# hash's and crypto's OpenSSL in one program: one provider, each archive once
# (spec section 5.5; tools/test/openssl_one_copy_test.py reads the link line).
hash-run openssl_one_copy : openssl_one_copy_test.cpp
  : <library>/webcpp/hash//openssl <library>/webcpp/crypto//openssl
  : native wasip2 wasip3 ;
# Naming the alias refuses an Emscripten program, by the forced include (its
# message is a fixture of tools/test/hash_jamfiles_test.py).
webcpp.compile-fail openssl_named_on_emscripten : hkdf_openssl_test.cpp
  : <library>/webcpp/hash//openssl : emscripten ;

build-project messages ;

# The C libraries' own suites, in the own lane c-suites.
build-project c_suites ;
