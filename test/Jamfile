  : <library>/third_party//sodium <library>/third_party//sodium-test-config ;
hash-run argon2id_interactive : argon2id_interactive_test.cpp
  : <library>/third_party//sodium <library>/third_party//sodium-test-config ;

# The family argon2 on backends::sodium (Argon2i and Argon2id, one lane):
