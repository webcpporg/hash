project : requirements <library>/webcpp/hash//hash ;

import feature ;
import regex ;
import webcpp ;
import webcpp-target ;

webcpp.targets native wasip2 wasip3 emscripten ;

# Every test runs with exceptions on and off: the second program has the suffix
# _no_exceptions and is built with exception-handling=off, which links
# tools/throw_exception.cpp.
rule hash-run ( name : sources + : requirements * : targets * )
{
    webcpp.run $(name) : $(sources) : $(requirements) : $(targets) ;
    webcpp.run $(name)_no_exceptions : $(sources)
      : $(requirements) <exception-handling>off : $(targets) ;
}

# Botan's tests (design D42, D43): Botan reports its errors by throwing,
# so a test of backends::botan has exceptions on and no _no_exceptions twin,
# on the targets /third_party//botan is built for.
rule botan-run ( name : sources + : requirements * )
{
    webcpp.run $(name) : $(sources)
      : $(requirements) <library>/third_party//botan <exception-handling>on
      : native emscripten ;
}

# The libraries of a test that links every library its target has: OpenSSL
# where webcpp builds it, which is not Emscripten.
rule openssl-off-emscripten ( properties * )
{
    if [ webcpp-target.target-of $(properties) ] != emscripten
    {
        return <library>/webcpp/hash//openssl ;
    }
}

# Botan in a native build with exceptions, and in no other: the headers-alone
# unit of backends/openssl.hpp (native, wasip2 and wasip3) links every library
# its target has, and Botan has no WASI build.
rule botan-native-with-exceptions ( properties * )
{
    if [ webcpp-target.target-of $(properties) ] = native
      && ! ( <exception-handling>off in $(properties) )
    {
        return <library>/third_party//botan ;
    }
}

