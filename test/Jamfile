# keccak.hpp compiles alone only with XKCP, whose target defines
# WEBCPP_HASH_HAS_XKCP (without it, it stops with its message).
webcpp.headers-alone hash : ../include : hash/keccak.hpp : <library>/third_party//xkcp ;
webcpp.headers-alone hash : ../include : hash/backends/xkcp.hpp
  : <library>/third_party//xkcp ;
# blake3.hpp compiles alone only with BLAKE3's library, which defines
# WEBCPP_HASH_HAS_BLAKE3 (without it, it stops with its message).
webcpp.headers-alone hash : ../include : hash/blake3.hpp
  : <library>/third_party//blake3 ;
webcpp.headers-alone hash : ../include : hash/backends/blake3.hpp
  : <library>/third_party//blake3 ;
# async.hpp compiles alone only with webcpp::asio, which hash.hpp does not
# bring (spec 11.2).
webcpp.headers-alone hash : ../include : hash/async.hpp
  : <library>/webcpp/asio//asio ;
# backends/webcrypto.hpp, which async.hpp includes, likewise: its engine on
# Emscripten, its limits on every target.
webcpp.headers-alone hash : ../include : hash/backends/webcrypto.hpp
  : <library>/webcpp/asio//asio ;
# backends/bearssl.hpp compiles alone only with BearSSL, whose target defines
# WEBCPP_HASH_HAS_BEARSSL (without it, it stops with its message).
webcpp.headers-alone hash : ../include : hash/backends/bearssl.hpp
  : <library>/third_party//bearssl ;

# backends/sodium.hpp compiles alone only with libsodium, which defines
# WEBCPP_HASH_HAS_SODIUM (without it, it stops with its message).
webcpp.headers-alone hash : ../include : hash/backends/sodium.hpp
  : <library>/third_party//sodium ;

# backends/openssl.hpp compiles alone only with /webcpp/hash//openssl, which
# defines WEBCPP_HASH_HAS_OPENSSL, on the targets where webcpp builds OpenSSL.
# Every other library is linked too (Botan natively), and webcpp::asio, so
# that every public header compiles with these options (the lint's aggregate
# translation unit, tools/lint/compile_commands.py).
webcpp.headers-alone hash : ../include : hash/backends/openssl.hpp
  : <library>/webcpp/hash//openssl <library>/third_party//xkcp
    <library>/third_party//blake3 <library>/third_party//bearssl
    <library>/third_party//sodium <library>/webcpp/asio//asio
    <conditional>@botan-native-with-exceptions
  : native wasip2 wasip3 ;

# backends/botan.hpp compiles alone with Botan, whose target defines
# WEBCPP_HASH_HAS_BOTAN, natively and on Emscripten, with exceptions (without
# the library it stops with its message; without exceptions it declares
# nothing).
webcpp.headers-alone hash : ../include : hash/backends/botan.hpp
  : <library>/third_party//botan <exception-handling>on : native emscripten ;

# config.hpp defines WEBCPP_HASH_NO_EXCEPTIONS exactly when webcpp has no
# exceptions, keeps it when a developer defines it, defines it when
# WEBCPP_NO_EXCEPTIONS is, and classifies the target.
webcpp.compile config : config_test.cpp ;
webcpp.compile config_no_exceptions : config_test.cpp : <exception-handling>off ;
webcpp.compile config_all_off : config_test.cpp
  : <define>WEBCPP_NO_EXCEPTIONS <define>WEBCPP_TEST_HASH_ALL_OFF ;
webcpp.compile config_developer_defined : config_test.cpp
  : <define>WEBCPP_HASH_NO_EXCEPTIONS <define>WEBCPP_TEST_HASH_DEVELOPER_DEFINED ;

# config.hpp defines WEBCPP_HASH_HAS_THREADS natively (BOOST_HAS_THREADS, in
# every native build) and on Emscripten with -pthread, never on WASI, and never
# with WEBCPP_HASH_NO_THREADS (spec 11.5, ruling R70): as the build asks; with
# threading=multi natively and on Emscripten (b2 adds -pthread); on wasip3's
# cooperative sysroot, which takes threading=multi without exceptions alone;
# and with the developer's WEBCPP_HASH_NO_THREADS.
webcpp.compile config_single : config_threads_test.cpp ;
webcpp.compile config_threads : config_threads_test.cpp
  : <threading>multi <define>WEBCPP_TEST_HASH_MULTI : native emscripten ;
webcpp.compile config_threads_wasip3 : config_threads_test.cpp
  : <threading>multi <exception-handling>off <define>WEBCPP_TEST_HASH_MULTI
  : wasip3 ;
webcpp.compile config_no_threads : config_threads_test.cpp
  : <define>WEBCPP_HASH_NO_THREADS ;

