# The default backends (spec 4.1): backends::hash2 for every key derivation,
# backends::sodium for argon2id and scrypt, whatever the program links and
# defines. With every library the target has (libsodium and BearSSL
# everywhere, OpenSSL where webcpp builds it), with no library at all, and
# with every library and the defines that chose a default before 2026-11-16,
# which choose nothing now.
rule hash-default ( name : sources + : requirements * )
{
    hash-run $(name) : $(sources)
      : $(requirements) <library>/third_party//sodium
        <library>/third_party//bearssl <library>/webcpp/hash//openssl
      : native wasip2 wasip3 ;
    hash-run $(name)_emscripten : $(sources)
      : $(requirements) <library>/third_party//sodium
        <library>/third_party//bearssl
      : emscripten ;
}
hash-default default_backend : default_backend_test.cpp ;
hash-run default_backend_hash2 : default_backend_test.cpp ;
hash-default default_backend_former_defines : default_backend_test.cpp
  : <define>WEBCPP_HASH_PROFILE_FASTEST <define>WEBCPP_HASH_PROFILE_SMALLEST
    <define>WEBCPP_HASH_PROFILE_BACKEND_BEARSSL <define>WEBCPP_PROFILE_FASTEST
    <define>WEBCPP_HASH_DEFAULT_BACKEND_HKDF_SODIUM
    <define>WEBCPP_HASH_DEFAULT_BACKEND_PBKDF2_BEARSSL ;

# doc/capabilities.json against backend_has_v cell by cell, its defaults
# against default_backend and default_async_backend (async.hpp, which needs
# webcpp::asio), and the refusal texts of the headers against its
# rows. Read at run time from the directories the defines give, quoted as
# wycheproof's are, with forward slashes, and preopened on WASI.
path-constant HASH_TEST_DOC : ../doc ;
path-constant HASH_TEST_INCLUDE : ../include ;
.hash-doc = [ regex.replace $(HASH_TEST_DOC) "\\\\" "/" ] ;
.hash-include = [ regex.replace $(HASH_TEST_INCLUDE) "\\\\" "/" ] ;
.hash-tables =
    <library>/webcpp//boost_json
    <define>"\"WEBCPP_TEST_HASH_DOC=\\\"$(.hash-doc)\\\"\""
    <define>"\"WEBCPP_TEST_HASH_INCLUDE=\\\"$(.hash-include)\\\"\""
    [ webcpp.data $(HASH_TEST_DOC) $(HASH_TEST_INCLUDE) ]
    <dependency>../doc/capabilities.json
    <dependency>../include/webcpp/hash/async.hpp
    <dependency>../include/webcpp/hash/detail/engines.hpp
    <dependency>../include/webcpp/hash/kdf.hpp
    <dependency>../include/webcpp/hash/backends/bearssl.hpp
    <dependency>../include/webcpp/hash/backends/botan.hpp
    <dependency>../include/webcpp/hash/backends/openssl.hpp
    <dependency>../include/webcpp/hash/backends/sodium.hpp
    <dependency>../include/webcpp/hash/backends/webcrypto.hpp ;
# capabilities links every library its target has, so that a backend's targets
# in the table can be checked against what links here.
hash-run capabilities : capabilities_test.cpp
  : $(.hash-tables) <library>/webcpp/asio//asio
    <library>/third_party//xkcp <library>/third_party//blake3
    <library>/third_party//sodium <library>/third_party//bearssl
    <library>/webcpp/hash//openssl
  : native wasip2 wasip3 ;
hash-run capabilities_emscripten : capabilities_test.cpp
  : $(.hash-tables) <library>/webcpp/asio//asio
    <library>/third_party//xkcp <library>/third_party//blake3
    <library>/third_party//sodium <library>/third_party//bearssl
  : emscripten ;
# The same with Botan, which a build with exceptions alone has: Botan's cells
# against backend_has_v and its refusal texts against the rows (the two
# programs above check that backend_has_v has no cell of Botan's there).
botan-run capabilities_botan : capabilities_test.cpp
  : $(.hash-tables) <library>/webcpp/asio//asio
    <library>/third_party//xkcp <library>/third_party//blake3
    <library>/third_party//sodium <library>/third_party//bearssl
    <conditional>@openssl-off-emscripten ;

# No allocation in webcpp's code (spec section 7.7): operator new and, where
# the target counts it, the C library's allocator are called zero times by
# every public function and backend, the families and the asynchronous family
# included, on every target (a control moves the counter). Argon2 and scrypt
# allocate inside libsodium and are asserted free of operator new only. Each
# library's functions are exercised where it is linked; the asynchronous
# family's storage is the handler's allocator's.
# On WASI the C allocator is counted through the linker's --wrap
# (support/counting.hpp), for the references of this program and its libraries.
hash-run allocation : allocation_test.cpp
  : <library>/webcpp/asio//asio
    <library>/third_party//xkcp <library>/third_party//blake3
    <library>/third_party//sodium <library>/third_party//bearssl
    <target-os>wasi:<linkflags>-Wl,--wrap=malloc,--wrap=calloc,--wrap=realloc,--wrap=aligned_alloc,--wrap=posix_memalign ;
# OpenSSL's own allocations per call of every entry point backends::openssl
# has (its digests, MACs and key derivations), measured through
# CRYPTO_set_mem_functions and printed, never bounded; operator new zero, and
# no allocation at all for a refusal by a guard.
hash-run allocation_openssl : allocation_openssl_test.cpp
  : <library>/webcpp/hash//openssl
    <target-os>wasi:<linkflags>-Wl,--wrap=malloc,--wrap=calloc,--wrap=realloc,--wrap=aligned_alloc,--wrap=posix_memalign
  : native wasip2 wasip3 ;

# detail::timing_guard sets DIT for its scope where the CPU has it and leaves
# the thread's state as it found it; its seam fires on every target for an
# engaged guard and never for a disengaged one. timing_threads adds a second
# thread, natively, with threads.
hash-run timing : timing_test.cpp ;
hash-run timing_threads : timing_test.cpp
  : <threading>multi <define>WEBCPP_TEST_TIMING_THREADS : native ;
# Without the seam, the guard takes a bool and no source_location, on every
# target; natively, at release, a program that calls mac reads its own
# executable and finds neither mac's name nor mac.hpp's path, which a guard's
# source_location would keep where its constructor is not inlined (clang on
# arm64).
hash-run timing_unseamed : timing_unseamed_test.cpp ;
webcpp.run timing_unseamed_release : timing_unseamed_test.cpp
  : <variant>release <define>WEBCPP_TEST_TIMING_READ_SELF : native ;

# The asynchronous forms set DIT on the thread that computes: the pool's for a
