hash-run openssl_one_copy : openssl_one_copy_test.cpp
  : <library>/webcpp/hash//openssl <library>/webcpp/crypto//openssl
  : native wasip2 wasip3 ;
# Agreement between backends (spec section 7.2): on 1,000 seeded random cases
# per hmac, the empty inputs first, every linked backend that has the key
# derivation gives the output of every other. Native, wasip2 and wasip3 link
# libsodium, BearSSL and OpenSSL; Emscripten links libsodium and BearSSL.
hash-run agreement_hkdf : agreement_hkdf_test.cpp
  : <library>/third_party//sodium <library>/third_party//bearssl
    <library>/webcpp/hash//openssl : native wasip2 wasip3 ;
hash-run agreement_hkdf_emscripten : agreement_hkdf_test.cpp
  : <library>/third_party//sodium <library>/third_party//bearssl : emscripten ;
hash-run agreement_pbkdf2 : agreement_pbkdf2_test.cpp
  : <library>/third_party//sodium <library>/third_party//bearssl
    <library>/webcpp/hash//openssl : native wasip2 wasip3 ;
hash-run agreement_pbkdf2_emscripten : agreement_pbkdf2_test.cpp
  : <library>/third_party//sodium <library>/third_party//bearssl : emscripten ;
# Naming the alias refuses an Emscripten program, by the forced include (its
# message is a fixture of tools/test/hash_jamfiles_test.py). The source is
# one that builds and runs on Emscripten without the alias (hkdf_hash2), so
# the forced include is the only thing that can stop it.
webcpp.compile-fail openssl_named_on_emscripten : hkdf_hash2_test.cpp
  : <library>/webcpp/hash//openssl : emscripten ;

# WebCrypto, node's crypto.subtle, as an outside oracle (Emscripten only, the
# default JSPI link): 200 random cases per function and hash, SHA-1, SHA-256,
# SHA-384 and SHA-512, of the digests, the hmacs, HKDF and PBKDF2, against
# Boost.Hash2 and every backend linked there (libsodium's two HKDFs, BearSSL).
hash-run webcrypto_oracle : webcrypto_oracle_test.cpp
  : <library>/third_party//sodium <library>/third_party//bearssl
    <linkflags>-sJSPI : emscripten ;

# Argon2id on backends::sodium: RFC 9106's case through libsodium's core
# argon2_ctx (four lanes, a secret, associated data); three cases of
# libsodium's own table, argon2id against argon2_ctx on 20 random cases, the
# guards, the presets; the interactive preset (64 MiB) in its own program.
hash-run argon2_rfc9106 : argon2_rfc9106_test.cpp
  : <library>/third_party//sodium <library>/third_party//sodium-test-config ;
