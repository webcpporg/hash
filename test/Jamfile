  : <library>/webcpp/hash//openssl
    <define>"\"WEBCPP_HASH_DETAIL_TEST_OPENSSL_DIGEST=\\\"NO-SUCH-DIGEST\\\"\""
  : native wasip2 wasip3 ;
# backends::openssl's limits (OpenSSL holds some lengths in an int), natively:
# spans of INT_MAX + 1 bytes over a few, which the guards refuse before
