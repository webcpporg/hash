{
    "boundaries": [
        {
            "headers": [
                "include/webcpp/hash/config.hpp",
                "include/webcpp/hash/error.hpp"
            ],
            "must-not-include": ["xkcp", "blake3", "sodium", "bearssl", "openssl/"],
            "why": "a program that only configures webcpp::hash or names its errors names no C library (spec section 2.1)"
        },
        {
            "headers": [
                "include/webcpp/hash/algorithms.hpp",
                "include/webcpp/hash/hmac.hpp"
            ],
            "must-not-include": ["xkcp", "blake3", "sodium", "bearssl", "openssl/"],
            "why": "Boost.Hash2's algorithms and HMAC need nothing but Boost (spec section 2.1)"
        },
        {
            "headers": [
                "include/webcpp/hash/backends/hash2.hpp",
                "include/webcpp/hash/detail/engines.hpp",
                "include/webcpp/hash/detail/limits.hpp",
                "include/webcpp/hash/detail/ranking.hpp",
                "include/webcpp/hash/detail/wipe.hpp",
                "include/webcpp/hash/hkdf.hpp",
                "include/webcpp/hash/kdf.hpp",
                "include/webcpp/hash/pbkdf2.hpp"
            ],
            "must-not-include": [
                "xkcp", "blake3", "sodium", "bearssl", "openssl/",
                "webcpp/hash/backends/sodium", "webcpp/hash/backends/bearssl",
                "webcpp/hash/backends/openssl"
            ],
            "why": "the key derivations' layer and backends::hash2 need nothing but Boost: a program that names no other backend links no C library (spec sections 2.12 and 2.13)"
        },
        {
            "headers": [
                "include/webcpp/hash/detail/xkcp.hpp",
                "include/webcpp/hash/keccak.hpp"
            ],
            "must-not-include": ["Keccak", "SnP", "brg_endian", "config.h", "align.h", "xkcp/"],
            "why": "no XKCP header, and with it XKCP's generated config.h, reaches a program's translation unit: webcpp's adapter is the only way in (spec section 2.6)"
        },
        {
            "headers": [
                "include/webcpp/hash/blake3.hpp"
            ],
            "must-not-include": ["xkcp", "sodium", "bearssl", "openssl/"],
            "why": "blake3 links BLAKE3's C implementation alone (spec section 2.7)"
        }
    ]
}
